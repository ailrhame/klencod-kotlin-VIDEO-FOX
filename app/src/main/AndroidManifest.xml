<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/ic_lock_lock"
        android:label="Video Fox"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <activity
            android:name=".MainActivity$MainFoxActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".MainActivity$TranslationService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE" value="video_translation_engine"/>
        </service>

        <receiver
            android:name=".MainActivity$OverlayReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.video.com.ACTION_TRANSLATE" />
            </intent-filter>
        </receiver>

    </application>
</manifest>